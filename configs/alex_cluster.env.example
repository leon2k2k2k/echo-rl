#!/usr/bin/env bash
# Alex-cluster defaults for ECHO RL smoke jobs.
#
# Copy to configs/alex_cluster.env for machine-local overrides.
#
# Expected shared layout:
#   echo repo: /home/fit/alex/WORK/leon/echo-rl
#   SkyRL:     /home/fit/alex/WORK/leon/SkyRL
#   runtime:   /home/fit/alex/WORK/leon/echo_rl_runtime
#
# Override any value before sourcing scripts/cluster_env.sh.

export ROOT="${ROOT:-/home/fit/alex/WORK/leon}"
export ECHO_REPO="${ECHO_REPO:-$ROOT/echo-rl}"
export SKYRL_DIR="${SKYRL_DIR:-$ROOT/SkyRL}"
export ECHO_RUNTIME_ROOT="${ECHO_RUNTIME_ROOT:-$ROOT/echo_rl_runtime}"
export ECHO_VENV="${ECHO_VENV:-$ECHO_RUNTIME_ROOT/venv}"
export PARTITION="${PARTITION:-a01}"

export TERMINAL_AGENT_TRAIN_PARQUET="${TERMINAL_AGENT_TRAIN_PARQUET:-/mnt/pvc/datasets/terminalagent/terminal-traindev/v0.1.5/qwen35_parquets/train8770_sa_q35xml_wip2.parquet}"
export TERMINAL_AGENT_VAL_PARQUET="${TERMINAL_AGENT_VAL_PARQUET:-/mnt/pvc/datasets/terminalagent/terminal-traindev/v0.1.5/qwen35_parquets/val100_sa_q35xml_wip2.parquet}"
